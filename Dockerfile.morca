# morca's default project image (morca aws push), plus the CA certificates at
# the paths libcurl, OpenSSL and flare look in. Drop this file once
# objectstore-mojo reads SSL_CERT_FILE and the system bundle.
# The image `morca aws push` builds for a project that added morca with
# `pixi shelf add morca-mojo`: its own `morca` (bin/scheduler.mojo, the two
# lines calling morca.command), its apps (every other bin/*.mojo, at
# /opt/morca/bin/<name>, which `morca aws app` runs) and its pipelines (every
# pipelines/*.mojo, at /opt/morca/pipelines/<name>), with `src/` on the
# import path if the project has one. A project with a Dockerfile.morca of
# its own builds that instead.
#
# They are two binaries in /opt/morca/bin, multicall-apps (morca, console)
# and multicall-pipelines (the rest), each running the program its name
# says, and each program's path is a link to one (scripts/build.sh): the
# code they share (morca, iceberg, parquet, flare...) is compiled once and is
# in the image once. Any change rebuilds all of one.
#
# MORCA_SOURCE and MORCA_COMMIT say what the pipelines were built from, which
# each run records and morca ui links. They are the final stage's environment,
# which `describe` reads (morca-mojo 0.25.1), not `-D` defines: a define with
# the commit in it made every commit a new compile, which the compile cache
# could never serve (#153).
#
# Everything is built with line tables (-g1) and the image has
# llvm-symbolizer, so a crash's stack dump in a run's driver.log names each
# frame's function, file and line. The line tables, compressed, make a
# binary about half as big again (gharchive: 4.2 MB, 6.5 MB with them,
# 25 MB uncompressed) and leave its speed as it was. Every build has them,
# pull requests' too: a different -g would be a different compile cache key.
#
# Mojo's compile cache (#153) is at MODULAR_CACHE_DIR, a BuildKit cache mount
# (`mojo-cache`) that CI carries from run to run (ci.yml). Paths are kept
# relative to the project in what is compiled (-strip-file-prefix), so a
# build elsewhere can share it.
#
# MOJO_TARGET_CPU: mojo build targets the build host's CPU by default. CI
# builds on GitHub's arm64 runners (Neoverse N2, Armv9 with SVE2), and Hetzner's
# CAX servers are Ampere Altra (Neoverse N1, Armv8.2), where those binaries die
# with SIGILL (exit 132). Neoverse N1 code also runs on N2, V1/V2 and Graviton.
# On amd64 CI passes x86-64-v3 (AVX2: Haswell, Zen 1 and later, which every
# Hetzner CPX/CCX and current cloud x86 server has).
#
# The stages are ordered for the layer cache (local builds; CI keeps none, #117): `env`
# is the pixi environment and depends only on pixi.toml and pixi.lock, and
# both `build` (the project's source) and `git` (via `curl`) start from it, so
# a commit that changes only source reuses `pixi install` and git as they were.
# The build arguments are declared in the stages that use them, after `env`:
# a RUN sees every ARG declared before it, so a new MORCA_COMMIT on each commit
# would otherwise rerun `pixi install` too.
# The bookworm variant: the stages built from `env` then link against the same
# glibc as the debian:bookworm-slim stages they run in, and apt reaches Debian's
# mirrors rather than archive.ubuntu.com, whose DNS failed for CI on
# 2026-11-11 (the default tag is Ubuntu noble).
FROM ghcr.io/prefix-dev/pixi:0.78.0-bookworm AS env
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src/project
COPY pixi.toml pixi.lock ./
RUN pixi install --locked

# MOJO_BUILD_JOBS: 1 builds the two multi-call binaries one after the other;
# otherwise scripts/build.sh builds them at once (see there).
FROM env AS build
ARG MOJO_TARGET_CPU=neoverse-n1
ARG MOJO_BUILD_JOBS=""
ENV MODULAR_CACHE_DIR=/mojo-cache
COPY . .
RUN --mount=type=cache,id=mojo-cache,target=/mojo-cache mkdir -p /out/bin /out/pipelines \
    && pixi run sh -c 'sh scripts/build.sh /out/bin /out/pipelines -g1 -strip-file-prefix=/src/project/ --target-cpu "$MOJO_TARGET_CPU" || exit 1; \
        echo "mojo build: peak memory $(awk "{print int(\$1 / 1048576)}" /sys/fs/cgroup/memory.peak 2> /dev/null) MB"; \
        if ls /out/pipelines/* > /dev/null 2>&1; then /out/bin/morca locate /out/pipelines/* --root .; fi'
# The line tables compressed, which llvm-symbolizer reads as they are: the
# binaries, not their links, which objcopy would replace with copies.
RUN for b in /out/bin/multicall-*; do objcopy --compress-debug-sections=zlib "$b" || exit 1; done
# Only the pixi environment's libraries the binaries link or dlopen: libpq
# (postgres), flare's shims (morca ui, apps), and every tin's shim, such as
# objectstore's and the codecs' (zstd, for Iceberg writes); and
# llvm-symbolizer, which Mojo's runtime runs to name a crash's frames, with
# what it links. Stripped of their symbol tables (libstdc++: 23.6 MB, 2.7
# stripped). Not conda's libpsl, which brings ICU (36 MB) and which libcurl
# alone links: the image has Debian's libpsl5. libpq once, with its two
# names as links. OpenSSL stays conda's: libcurl and libpq need 3.2.
RUN env=/src/project/.pixi/envs/default && mkdir -p /out/lib /out/libexec \
    && cp -L $env/bin/llvm-symbolizer /out/libexec/ \
    && loaded=$(ls $env/lib/libflare_*.so $env/lib/lib*mojo*.so 2>/dev/null) \
    && ldd /out/bin/* /out/pipelines/* /out/libexec/* $loaded $env/lib/libpq.so.5 2> /dev/null \
        | awk -v e="$env" '$3 ~ "^"e {print $3}' | grep -v -e '/libicu' -e '/libpsl' -e '/libpq\.' \
        | sort -u | xargs -r cp -L -t /out/lib \
    && cp -L -t /out/lib $loaded \
    && pq=$(basename $(readlink -f $env/lib/libpq.so.5)) && cp -L $env/lib/$pq /out/lib/ \
    && ln -s $pq /out/lib/libpq.so.5 && ln -s libpq.so.5 /out/lib/libpq.so \
    && for f in /out/lib/*; do [ -L "$f" ] || strip --strip-unneeded "$f" || exit 1; done

# git, for mojo_history and mojo_versions: only the `git` binary (every
# builtin they run) and git-remote-https, without Perl, Tcl/Tk, gettext,
# Python or expat (Debian's git package and what it pulls in: 90 MB; this,
# 5 MB). Built on the image's Debian against the pixi environment's libcurl,
# which /opt/morca/lib ships anyway (objectstore links it). `curl` gathers
# libcurl, the pixi libraries it links (not libpsl or ICU, as above) and its
# headers from `env`, not from `build`, so git is built again only when the
# pixi environment changes.
FROM env AS curl
RUN env=/src/project/.pixi/envs/default && mkdir -p /deps/lib /deps/include \
    && cp -L $env/lib/libcurl.so.4 /deps/lib/ \
    && ldd $env/lib/libcurl.so.4 | awk -v e="$env" '$3 ~ "^"e {print $3}' \
        | grep -v -e '/libicu' -e '/libpsl' | sort -u | xargs -r cp -L -t /deps/lib \
    && cp -r $env/include/curl /deps/include/

FROM debian:bookworm-slim AS git
# The tarball is pinned by its sha256 (kernel.org's sha256sums.asc) and
# fetched with retries from kernel.org's mirrors in turn: edge timeouts
# failed image builds (morca #468, census #186). Bump GIT_SHA256 with GIT_VERSION.
ARG GIT_VERSION=2.51.2
ARG GIT_SHA256=233d7143a2d58e60755eee9b76f559ec73ea2b3c297f5b503162ace95966b4e3
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl gcc make libc6-dev \
      zlib1g-dev libpsl5 xz-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=curl /deps /deps
RUN f=git-$GIT_VERSION.tar.xz \
    && for m in https://mirrors.edge.kernel.org https://cdn.kernel.org https://www.kernel.org; do \
        curl -fsSL --retry 5 --retry-all-errors --connect-timeout 20 -o /tmp/$f $m/pub/software/scm/git/$f \
          && echo "$GIT_SHA256  /tmp/$f" | sha256sum -c - && break; \
        rm -f /tmp/$f; \
      done \
    && test -f /tmp/$f && tar xJf /tmp/$f -C /usr/src && rm /tmp/$f \
    && cd /usr/src/git-$GIT_VERSION && ln -s libcurl.so.4 /deps/lib/libcurl.so \
    && make -j"$(nproc)" prefix=/opt/morca gitexecdir=/opt/morca/libexec/git \
        template_dir=/opt/morca/libexec/git/templates \
        NO_PERL=1 NO_TCLTK=1 NO_GETTEXT=1 NO_PYTHON=1 NO_EXPAT=1 NO_OPENSSL=1 NO_INSTALL_HARDLINKS=1 \
        CURL_CFLAGS=-I/deps/include CURL_LDFLAGS='-L/deps/lib -lcurl -Wl,-rpath-link,/deps/lib' \
        git git-remote-http \
    && mkdir -p /opt/morca/bin /opt/morca/libexec/git/templates \
    && install -s git /opt/morca/libexec/git/git \
    && install -s git-remote-http /opt/morca/libexec/git/git-remote-https \
    && ln -s ../libexec/git/git /opt/morca/bin/git

FROM debian:bookworm-slim
# libpsl5 for libcurl (see above).
RUN apt-get update && apt-get install -y --no-install-recommends tzdata ca-certificates libpsl5 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/lib /opt/morca/lib
COPY --from=build /out/bin /opt/morca/bin
COPY --from=build /out/pipelines /opt/morca/pipelines
COPY --from=build /out/libexec /opt/morca/libexec
COPY --from=git /opt/morca /opt/morca
# libcurl (objectstore) and OpenSSL (flare) look for CA certificates under
# the build environment's prefix, compiled in when conda relocated them, so
# keep that directory at the same path.
COPY --from=build /src/project/.pixi/envs/default/ssl /src/project/.pixi/envs/default/ssl
# gharchive's fetch hands flare $CONDA_PREFIX/ssl/cacert.pem, and
# CONDA_PREFIX is /opt/morca here.
COPY --from=build /src/project/.pixi/envs/default/ssl /opt/morca/ssl
# The census's settings, and what `morca register` (no arguments) reads: every
# pipeline in morca.toml, from MORCA_PIPELINES_DIR, with the commit and source
# these were built from. morca.dev.toml is the dev stack's (no fills, no
# worker pool), which it reads with MORCA_CONFIG=/opt/morca/morca.dev.toml;
# morca.lab.toml the lab stack's (ballast only).
COPY --from=build /src/project/morca.toml /src/project/morca.dev.toml /src/project/morca.lab.toml /opt/morca/
# The console's Changelog tab (/how/changelog) reads it; deploy.sh reads
# upgrade.toml, the steps a deploy of each release needs (MORCA_UPGRADE).
COPY --from=build /src/project/CHANGELOG.md /src/project/upgrade.toml /opt/morca/
ARG MORCA_SOURCE=""
ARG MORCA_COMMIT=""
# The release this image is (`1.2.0`), empty for one built from a branch; the
# console's footer shows it, else the commit.
ARG CENSUS_VERSION=""
ENV MORCA_CONFIG=/opt/morca/morca.toml MORCA_PIPELINES_DIR=/opt/morca/pipelines \
    CENSUS_CHANGELOG=/opt/morca/CHANGELOG.md MORCA_UPGRADE=/opt/morca/upgrade.toml \
    MORCA_SOURCE=${MORCA_SOURCE} MORCA_COMMIT=${MORCA_COMMIT} CENSUS_VERSION=${CENSUS_VERSION}
ENV CONDA_PREFIX=/opt/morca LD_LIBRARY_PATH=/opt/morca/lib PATH=/opt/morca/bin:/opt/morca/pipelines:/usr/bin:/bin \
    LLVM_SYMBOLIZER_PATH=/opt/morca/libexec/llvm-symbolizer GIT_EXEC_PATH=/opt/morca/libexec/git
ENTRYPOINT ["/opt/morca/bin/morca"]
